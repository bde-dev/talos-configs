# Azure service principal used to read secrets from Key Vault (bde-dev-kv-homelab).
# Copy this file to .env, fill in the two values, then:  mise run bootstrap-env
#
# Only CLIENT_SECRET is sensitive. CLIENT_ID is a non-secret app id — you can
# instead set it in mise.toml [env] to keep .env down to the one secret.
# Tenant and vault name are already set (non-secret) in mise.toml [env].

CLIENT_ID=
CLIENT_SECRET=
